# Vercel project environment for apps/web.
# Set the project root directory to apps/web. Do not put these values in browser code.
# WEB_ORIGIN must match the API WEB_ORIGIN and must not have a trailing slash.

WEB_ORIGIN=https://admin.example.com
# FastAPI origin published by the Cloudflare Tunnel. HTTPS only.
API_UPSTREAM_URL=https://api.example.com
# Access service token for the API hostname. Server-side only.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Same issuer as the API. CF_ACCESS_AUD is the Vercel Access application audience.
# Add the API application audience, comma-separated, only when that JWT must also verify.
CF_ACCESS_ISSUER=https://team.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_JWKS_URL=
# Comma-separated owner emails allowed to enqueue power commands.
POWER_OWNER_EMAILS=
# Upstash Redis REST. Vercel KV and the Upstash integration use the same REST API.
# Aliases accepted when this pair is unset: UPSTASH_REDIS_REST_URL/TOKEN, KV_REST_API_URL/TOKEN.
POWER_STORE_REST_URL=
POWER_STORE_REST_TOKEN=
POWER_DEVICE_ID=home-pc
# 32 random bytes as lowercase hex: openssl rand -hex 32
# Copy the same value into firmware/esp32-power/config.h. Never commit that file.
POWER_DEVICE_SECRET=
# Temporary first-passkey enrollment secret. Remove it after the owner enrolls.
POWER_BOOTSTRAP_TOKEN=
# Optional. Defaults to the WEB_ORIGIN hostname and "HomeServer Admin".
POWER_RP_ID=
POWER_RP_NAME=HomeServer Admin
