APP_ENV=development
APP_MODE=mock
APP_DATA_DIR=.data
AUDIT_RETENTION_DAYS=365
GHCR_NAMESPACE=ghcr.io/haheonhwi/homeserver-admin
IMAGE_TAG=v1.0.0
# Home-server images only. Copy API and Agent digests from the tagged GitHub Actions summary.
# The Next.js app is deployed on Vercel and is not published to GHCR.
API_IMAGE_DIGEST=
AGENT_IMAGE_DIGEST=
TUNNEL_NETWORK=cloudflared
# Public Vercel origin. The API uses it for WebAuthn and as the allowed browser origin.
WEB_ORIGIN=
# Temporary per-account enrollment secret; clear after first Passkey enrollment.
WEBAUTHN_BOOTSTRAP_TOKEN=
CF_ACCESS_ISSUER=
CF_ACCESS_AUD=
CF_ACCESS_JWKS_URL=
OWNER_EMAILS=
OPERATOR_EMAILS=
HOST_AGENT_TOKEN=
PORTAINER_URL=
PORTAINER_API_KEY=
# Separate least-privilege key for fixed start/stop/restart actions; unset keeps Docker read-only
PORTAINER_ACTIONS_API_KEY=
PORTAINER_ENDPOINT_ID=0
# Optional read-only health checks; internal service URLs or HTTPS origins
N8N_URL=
# Optional recent execution metadata; use Execution:list scope where available, never execution data
N8N_API_KEY=
OPENCLAW_URL=
# Optional single-host Netdata alert reads; private HTTPS origin or http://netdata:19999
NETDATA_URL=
# Optional bearer token only when Netdata Agent bearer protection is enabled
NETDATA_API_TOKEN=
# Optional Scrutiny read-only summary; private HTTPS origin or http://scrutiny:8080
SCRUTINY_URL=
# Optional mailcow read-only API, restricted to HTTPS and Owner/Operator access
MAILCOW_URL=
MAILCOW_API_KEY=
# Optional read-only DB metrics; require sslmode=verify-full and a trusted CA (sslrootcert=system or a CA file in the API container)
POSTGRES_URL=
# Remote Redis requires rediss://; redis:// is limited to the internal redis service or loopback.
REDIS_URL=
# Optional ntfy delivery; HTTPS or internal http://ntfy:80, status transitions only
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Optional fine-grained token with Actions: read for only these repositories
GITHUB_API_TOKEN=
# Comma-separated owner/repo allowlist (maximum 3)
GITHUB_REPOSITORIES=
# Optional read-only DNS lookup; scope token to DNS Read for this zone
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional DNS writes: separate token scoped to DNS Write on this one zone.
CLOUDFLARE_DNS_WRITE_TOKEN=
CLOUDFLARE_ZONE_NAME=
# Optional storage overlay: existing non-sensitive files on distinct filesystems
# HOST_SSD_PATH=/path/to/existing-ssd-probe-file
# HOST_HDD_PATH=/path/to/existing-hdd-probe-file

# --- Vercel frontend ---
# Put these in the Vercel project (root directory apps/web), not in the home-server API container.
# See .env.vercel.example. Do not expose the service token, device secret, store token, or bootstrap token to the browser.
# API_UPSTREAM_URL=https://api.example.com
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# POWER_OWNER_EMAILS=
# POWER_STORE_REST_URL=
# POWER_STORE_REST_TOKEN=
# POWER_DEVICE_ID=home-pc
# POWER_DEVICE_SECRET=
# POWER_BOOTSTRAP_TOKEN=
# POWER_RP_ID=
# POWER_RP_NAME=HomeServer Admin
# Local Compose only. Ignored on Vercel. Lets the power page open without Cloudflare Access.
# POWER_DEV_AUTH=1
